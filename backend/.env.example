# Copy to backend/.env. Never put this key in browser/extension code.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Select a text model supporting JSON Schema in your Nebius account.
NEBIUS_MODEL=openai/gpt-oss-120b
NEBIUS_TIMEOUT_SECONDS=30
# Additional SDK attempts after the first (connection errors / 408 / 409 / 429 / 5xx).
NEBIUS_MAX_RETRIES=1
# Optional bearer token for this backend, separate from the Nebius credential.
# Leave empty only for local development bound to 127.0.0.1.
FIREWALL_API_TOKEN=
# JSON array; explicit extension origin(s) can be added for browser integration.
FIREWALL_CORS_ORIGINS=[]
